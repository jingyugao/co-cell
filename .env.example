# Optional. With no API key, uses the local Codex login/configuration.
# CODEX_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# CODEX_PATH=/absolute/path/to/codex
CODEX_MODEL=gpt-5.6-terra
# CODEX_WORKSPACE=/absolute/path/to/project
# Optional JSON metadata / legacy import source (default: data/web-state).
# CODEX_WEB_DATA_DIR=/absolute/path/to/private/session-storage
# Uploaded images; independent of JSON/MySQL session metadata (default: data/images).
# CODEX_WEB_IMAGES_DIR=/absolute/path/to/private/images
PORT=3001
# When sharing an existing Meegle OAuth login with Docker, use the source
# machine's hostname and USER (the CLI binds its refresh store to both).
# MEEGLE_AUTH_HOSTNAME=your-hostname
# MEEGLE_AUTH_USER=your-user
# MEEGLE_HOME=/home/your-user/.meegle
# Do not set MEEGLE_USER_ACCESS_TOKEN when using OAuth automatic refresh.
# Optional SDK config object / raw TOML overrides, applied on top of local config.
# CODEX_CONFIG_JSON={"features":{"multi_agent":true}}
# CODEX_CONFIG_OVERRIDES_JSON=[]
# OPENAI_BASE_URL registers a custom codex_web_proxy provider using HTTP streaming.
# The Sandbox diagnostics/retry proxy requires HTTP streaming (not WebSocket).
# Existing deployments default to new-api (application-managed channel-pinned retries).
# For CLIProxyAPI, the proxy owns upstream retries; CODEX_API_KEY is its client key.
# CODEX_PROXY_KIND=cliproxyapi
# OPENAI_BASE_URL=http://host.docker.internal:8317/v1
# Setup: pnpm cliproxyapi init, pnpm cliproxyapi use-local, pnpm cliproxyapi check
# use-local mirrors only the current access token; host Codex remains the refresh owner.
# Or use up + login for independent OAuth. See tmp/docs/cliproxyapi.md.
# LiteLLM disables SDK/application retries; the generated proxy config also defaults to no retries.
# CODEX_API_KEY is the LiteLLM client key.
# CODEX_PROXY_KIND=litellm
# COMPOSE_PROFILES=litellm
# LITELLM_LISTEN=127.0.0.1
# LITELLM_UID=1000
# LITELLM_GID=1000
# OPENAI_BASE_URL=http://host.docker.internal:8317/v1
# Setup scripts: scripts/litellm/. See tmp/docs/litellm.md.

# Docker is the only Sandbox provider. Local deployments intentionally trust the Docker socket.
# DOCKER_SANDBOX_IMAGE=swarm-hive-sandbox:latest
# SANDBOX_WORKSPACE=/home/user/workspace
# SANDBOX_ARCHIVED_RECLAIM_AFTER_MS=86400000
# SANDBOX_LIFECYCLE_SCAN_INTERVAL_MS=60000

# Optional: persistent SQLite database for agent improvement proposals (default: ./data/improvements.sqlite).
# IMPROVEMENTS_DB_PATH=/absolute/path/improvements.sqlite

# MySQL for Codex Web's future project/session persistence. The container is
# published only to localhost by default; set non-default strong passwords
# before a production deployment.
# MYSQL_DATABASE=swarm_hive
# MYSQL_USER=swarm_hive
# MYSQL_PASSWORD=replace-with-a-strong-password
# MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
# MYSQL_LISTEN=127.0.0.1
# MYSQL_PORT=3307
# MYSQL_URL=mysql://swarm_hive:replace-with-a-strong-password@mysql:3306/swarm_hive
