OPENAI_API_KEY=
OPENAI_BASE_URL=https://openai-compatible.example.com
# Optional absolute path; defaults to $HOME/.swarm-hive/chatgpt-auth.json.
SWARM_HIVE_AUTH_FILE=

FeishuProjectMcpUrl=https://project.feishu.cn/mcp_server/v1
FeishuProjectMcpToken=
LARK_APP_ID=
LARK_APP_SECRET=

GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_USERNAME=oauth2

AGENT_SPEC_DIR=/app/agent-specs/software-engineer
AGENT_SPECS_ROOT=/app/agent-specs
# Shared tool/credential runtime; role Specs only define prompt and memory.
AGENT_RUNTIME_SPEC_KEY=software-engineer
AGENT_SANDBOX=shared-docker
AGENT_SANDBOX_IMAGE=swarm-hive-sandbox-python:3.12
AGENT_SANDBOX_DOCKERFILE=agent-specs/software-engineer/sandbox/Dockerfile
AGENT_SHARED_SANDBOX_NAME=swarm-hive-dev-sandbox
AGENT_SANDBOX_NETWORK=bridge
AGENT_WORKSPACE_ROOT=/srv/agent-workspaces
# Persistent layout:
#   $AGENT_WORKSPACE_ROOT/specs/<spec-slug>/home/.local
#   $AGENT_WORKSPACE_ROOT/specs/<spec-slug>/home/projects/<project-slug>
# Dedicated read-only kubeconfig. In Compose, place it below
# AGENT_WORKSPACE_ROOT/.credentials/ so the controller and Docker daemon can
# access the same absolute path.
AGENT_KUBECONFIG=

# For agent-control running in Compose:
# AGENT_DATABASE_URL=postgresql://agent:REDACTED_PASSWORD@checkpoint-postgres:5432/swarm_hive
# AGENT_CHECKPOINT_DATABASE_URL=postgresql://agent:REDACTED_PASSWORD@checkpoint-postgres:5432/swarm_hive
AGENT_CHECKPOINT_SCHEMA=public

# Compact old Agent messages once either threshold is reached. The latest
# context is kept verbatim; older context is replaced by a durable summary.
AGENT_CONTEXT_COMPRESSION_TRIGGER_TOKENS=40000
AGENT_CONTEXT_COMPRESSION_TRIGGER_MESSAGES=60
AGENT_CONTEXT_COMPRESSION_KEEP_TOKENS=12000
AGENT_CONTEXT_COMPRESSION_SUMMARY_INPUT_TOKENS=32000

AGENT_SERVER_HOST=0.0.0.0
AGENT_SERVER_PORT=3000
AGENT_WEB_ROOT=dist/web
