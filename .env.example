# Minimal native Codex workbench. Private .env is preserved.
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=3000
AGENT_WEB_ROOT=dist/web
NATIVE_DATA_DIR=data/native
CODEX_PUBLIC_ORIGIN=

# Explicit E2B endpoint; never silently falls back to E2B Cloud.
E2B_API_KEY=
E2B_API_KEY_FILE=data/e2b/api-key
E2B_DOMAIN=localhost
E2B_API_URL=http://127.0.0.1:13000
E2B_SANDBOX_URL=http://127.0.0.1:13002
E2B_TEMPLATE=base
CODEX_WORKSPACE_SECRET=

# Official CLI. No default workflow/MCP/memory injection.
CODEX_VERSION=0.153.4
CODEX_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=
OPENAI_API_KEY=
CODEX_AUTH_JSON_PATH=
