{
  "name": "codex-web-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "capture:http": "tsx server/diagnostics/capture-demo.ts",
    "credentials:import": "tsx server/connections/import-local.ts",
    "cliproxyapi": "node scripts/cliproxyapi/manage.mjs",
    "e2b:build": "node scripts/e2b/build-template.mjs && node scripts/e2b/verify-template.mjs",
    "kubernetes:configure": "node scripts/kubernetes-admin.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@openai/codex-sdk": "0.153.4",
    "e2b": "2.46.1",
    "hono": "4.13.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
