# Copy to deploy.env (ignored by Git). Shell environment overrides these values.
# Use absolute paths: dotenv does not expand ~, $HOME or ${VARIABLE}.
COCELL_KUBE_CONTEXT=YOUR_TEST_CONTEXT
COCELL_NAMESPACE=co-cell
COCELL_HELM_RELEASE=co-cell
COCELL_REGISTRY_ENDPOINT=http://REGISTRY_HOST:PORT
# Enable after bootstrapping the coordinated single replica once.
# COCELL_MULTI_API=1
# COCELL_API_REPLICAS=2
CELLBOX_SOURCE_DIR=/ABSOLUTE/PATH/TO/cell-box
CELLBOX_PROFILE=cocell-k8s-resumable
CELLBOX_CLIENT_ID=cocell
CELLBOX_REVISION_ID=REPLACE_WITH_CELLBOX_REVISION_ID
# For a first family bootstrap, set both selectors empty and COCELL_CELLBOX_CREATE_TEMPLATE=1.
# To follow a moving stable pointer instead, set CELLBOX_REVISION_ID empty and set CELLBOX_TEMPLATE_ID.
# CELLBOX_TEMPLATE_ID=
COCELL_CELLBOX_NODE_NAME=YOUR_CELLBOX_NODE
COCELL_CELLBOX_STORAGE_HOST_PATH=/ABSOLUTE/NEW/CELLBOX/DATA/DIRECTORY
# Or set COCELL_CELLBOX_STORAGE_CLAIM=NEW_PVC_NAME and leave the hostPath empty.
COCELL_CELLBOX_STORAGE_CLAIM=
COCELL_CELLBOX_OBJECT_STORAGE_PREFIX=cocell-v2
# Set to 1 only for the one-time first family creation; save the printed ID before another invocation.
COCELL_CELLBOX_CREATE_TEMPLATE=0
COCELL_CELLBOX_TEMPLATE_NAME=cocell-system
# Download dependencies first, then build the runtime without network access.
# COCELL_USER_BASE_IMAGE=node:22.18.0-bookworm-slim
# COCELL_RUNTIME_IMAGE=cocell-runtime:local
# COCELL_PROXY_TOOLS=git glab kubectl mysql meegle lark-cli

# Optional proxy bypass for the registry/node addresses.
# NO_PROXY=127.0.0.1,localhost,REGISTRY_HOST,NODE_HOST
# no_proxy=127.0.0.1,localhost,REGISTRY_HOST,NODE_HOST

# Live tests read the existing operator Secret and open a loopback port-forward.
# No credential values need to be stored here. This context must be explicit.
COCELL_E2E_KUBE_CONTEXT=YOUR_TEST_CONTEXT
COCELL_E2E_NAMESPACE=co-cell
COCELL_E2E_HELM_RELEASE=co-cell
COCELL_E2E_SERVICE=co-cell

# Or connect directly, without Kubernetes:
# COCELL_E2E_BASE_URL=https://YOUR_COCELL_ORIGIN
# COCELL_E2E_ACCESS_TOKEN=SUPPLY_THROUGH_ENVIRONMENT
# COCELL_E2E_PUBLIC_URL=https://PUBLIC_ORIGIN_IF_DIFFERENT
# COCELL_E2E_MODEL=gpt-6-luna
