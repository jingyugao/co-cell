#!/usr/bin/env bash
set -euo pipefail

if ! command -v codex >/dev/null 2>&1; then
  echo "apply_patch requires the Codex CLI on PATH" >&2
  exit 127
fi

if [[ $# -gt 0 ]]; then
  patch_body=$1
else
  patch_body=$(</dev/stdin)
fi

workspace=$(pwd -P)
while IFS= read -r line; do
  case "$line" in
    "*** Add File: "*|"*** Delete File: "*|"*** Update File: "*|"*** Move to: "*)
      patch_path=${line#*: }
      if [[ -z "$patch_path" ]]; then
        echo "apply_patch rejected an empty path" >&2
        exit 2
      fi
      resolved=$(realpath -m -- "$patch_path")
      if [[ "$resolved" != "$workspace" && "$resolved" != "$workspace/"* ]]; then
        echo "apply_patch path escapes workspace: $patch_path" >&2
        exit 2
      fi
      ;;
  esac
done <<<"$patch_body"

exec codex --codex-run-as-apply-patch "$patch_body"
