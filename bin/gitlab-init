#!/bin/sh
set -eu

: "${GITLAB_BASE_URL:?GITLAB_BASE_URL is required}"
: "${GITLAB_HOST:?GITLAB_HOST is required}"
: "${GITLAB_TOKEN:?GITLAB_TOKEN is required}"

export HOME="${HOME:-/tmp/agent-home}"
export GLAB_CONFIG_DIR="${GLAB_CONFIG_DIR:-$HOME/.config/glab-cli}"
mkdir -p "$HOME" "$GLAB_CONFIG_DIR"

case "$GITLAB_BASE_URL" in
  https://*) protocol=https ;;
  http://*) protocol=http ;;
  *) echo "Unsupported GITLAB_BASE_URL protocol" >&2; exit 1 ;;
esac

auth_log=/tmp/glab-auth.log
if ! glab auth status --hostname "$GITLAB_HOST" >"$auth_log" 2>&1; then
  if ! printf '%s' "$GITLAB_TOKEN" | glab auth login \
      --hostname "$GITLAB_HOST" \
      --stdin \
      --git-protocol "$protocol" \
      --api-protocol "$protocol" \
      >"$auth_log" 2>&1; then
    cat "$auth_log" >&2
    exit 1
  fi
fi

if ! glab auth status --hostname "$GITLAB_HOST" >"$auth_log" 2>&1; then
  cat "$auth_log" >&2
  exit 1
fi
printf 'gitlab=%s authenticated\n' "$GITLAB_HOST"

if [ -n "${GITLAB_REPOSITORY:-}" ]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git remote get-url origin >/dev/null 2>&1; then
      actual_origin=$(git remote get-url origin | sed -E 's#/*$##; s#\.git$##')
      expected_origin=$(printf '%s' "$GITLAB_REPOSITORY" | sed -E 's#/*$##; s#\.git$##')
      if [ "$actual_origin" != "$expected_origin" ]; then
        echo "Existing origin does not match GITLAB_REPOSITORY" >&2
        exit 1
      fi
    else
      git remote add origin "$GITLAB_REPOSITORY"
      git fetch origin --prune
    fi
  else
    if find . -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
      echo "Workspace is non-empty but is not a Git repository" >&2
      exit 1
    fi
    glab repo clone "$GITLAB_REPOSITORY" .
  fi
fi

gitlab_user=$(glab api user --hostname "$GITLAB_HOST")
if ! git config --get user.name >/dev/null 2>&1; then
  git_name=$(printf '%s' "$gitlab_user" | jq -r '.name // .username // empty')
  if [ -z "$git_name" ]; then
    echo "Unable to determine Git author name from GitLab" >&2
    exit 1
  fi
  git config user.name "$git_name"
fi
if ! git config --get user.email >/dev/null 2>&1; then
  git_email=$(printf '%s' "$gitlab_user" | jq -r '.public_email // .email // empty')
  if [ -z "$git_email" ]; then
    git_username=$(printf '%s' "$gitlab_user" | jq -r '.username // empty')
    email_host=$(printf '%s' "$GITLAB_HOST" | tr ':/' '-')
    git_email="${git_username:-agent}@users.noreply.${email_host}"
  fi
  git config user.email "$git_email"
fi

if [ -n "${GITLAB_FEATURE_BRANCH:-}" ]; then
  current_branch=$(git branch --show-current)
  if [ "$current_branch" != "$GITLAB_FEATURE_BRANCH" ]; then
    if git show-ref --verify --quiet "refs/heads/$GITLAB_FEATURE_BRANCH"; then
      git switch "$GITLAB_FEATURE_BRANCH"
    elif git show-ref --verify --quiet "refs/remotes/origin/$GITLAB_FEATURE_BRANCH"; then
      git switch --track "origin/$GITLAB_FEATURE_BRANCH"
    else
      git switch -c "$GITLAB_FEATURE_BRANCH"
    fi
  fi
fi

printf 'repository=%s\n' "$(git remote get-url origin)"
printf 'branch=%s\n' "$(git branch --show-current)"
