{
  "name": "co-cell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "tsx backend/index.ts",
    "build": "pnpm typecheck && vite build",
    "start": "NODE_ENV=production tsx backend/index.ts",
    "typecheck": "tsc --noEmit",
    "capture:http": "tsx backend/infra/diagnostics/capture-demo.ts",
    "sandbox:timing": "node scripts/diagnostics/sandbox-timing.mjs",
    "credentials:import": "tsx backend/connections/import-local.ts",
    "credentials:import-directory": "node scripts/credentials/import-directory.mjs",
    "credentials:migrate": "tsx backend/connections/migrate-credentials.ts",
    "cliproxyapi": "node scripts/cliproxyapi/manage.mjs",
    "env:audit": "node scripts/config/audit-env.mjs",
    "test:integration": "node scripts/integration/run.mjs ui",
    "test:integration:reads": "node scripts/integration/run.mjs reads",
    "test:integration:live": "node scripts/integration/run.mjs live",
    "test:integration:full": "node scripts/integration/run.mjs full",
    "test:integration:lifecycle": "node scripts/integration/run.mjs lifecycle",
    "test:integration:user-input": "node scripts/integration/run.mjs user-input",
    "test:integration:cleanup": "node scripts/integration/cleanup.mjs"
  },
  "dependencies": {
    "@co-cell/agentcore": "file:packages/agentcore",
    "@co-cell/sandbox": "file:packages/sandbox",
    "@hono/node-server": "2.1.1",
    "@openai/codex": "0.153.4",
    "hono": "4.13.5",
    "js-tiktoken": "1.0.21",
    "mysql2": "3.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
