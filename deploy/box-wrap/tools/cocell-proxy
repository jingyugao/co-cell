#!/usr/local/bin/node
import { runProtectedTool } from '/opt/product/cocell/protected-tool.mjs';

const forwarded = process.argv.slice(4);
const tool = forwarded.shift();
try {
  if (process.argv[2] !== '--dynamic') throw new Error('Invalid dynamic tool invocation');
  if (!/^[A-Za-z][A-Za-z0-9_.-]{0,63}$/.test(tool ?? '')) throw new Error('Invalid dynamic tool name');
  process.exitCode = await runProtectedTool(tool, forwarded);
}
catch (error) {
  console.error(error);
  process.exitCode = 1;
}
