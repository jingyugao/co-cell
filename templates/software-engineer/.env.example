OPENAI_API_KEY=
OPENAI_BASE_URL=https://openai-compatible.example.com

GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_USERNAME=oauth2
GITLAB_REPOSITORY=https://gitlab.example.com/group/project
# GITLAB_TARGET_BRANCH=master

AGENT_TEMPLATE_DIR=/app/templates/software-engineer
AGENT_SANDBOX=shared-docker
