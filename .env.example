# Configure model authentication for the remote Codex process. Host login is not mounted into Cellbox.
# CODEX_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# CODEX_PATH=/absolute/path/to/codex
CODEX_MODEL=gpt-5.6-terra
# CODEX_WORKSPACE=/absolute/path/to/project
# Local session assets and archive paths (default: data/web-state); metadata is in MySQL.
# CODEX_WEB_DATA_DIR=/absolute/path/to/private/session-assets
# Uploaded images; independent of MySQL session metadata (default: data/images).
# CODEX_WEB_IMAGES_DIR=/absolute/path/to/private/images
PORT=3001
# Cellbox backend uses Kubernetes with resumable Pods.
CELLBOX_KIND=k8s-resumable
CELLBOX_API_URL=http://127.0.0.1:8090
CELLBOX_API_TOKEN=replace-with-cellbox-client-token
CELLBOX_PROFILE=cocell-k8s-resumable
# Deployment tools use the external Cellbox Helm release (separate from CoCell).
# COCELL_CELLBOX_RELEASE=cellbox
# COCELL_CELLBOX_NAMESPACE=cell-box
# Separate product login token (minimum 32 bytes), never a Cellbox client token.
COCELL_ACCESS_TOKEN=replace-with-at-least-32-random-bytes
COCELL_PUBLIC_URL=http://127.0.0.1:3001
# Generate once with: node -e 'process.stdout.write(require("crypto").randomBytes(32).toString("base64"))'
# Keep this key outside database backups; changing it requires re-encrypting Secrets.
COCELL_SECRET_MASTER_KEY=replace-with-base64-encoded-32-byte-key
# Origin reachable from the Sandbox network, without a path or trailing slash.
COCELL_TOOL_BROKER_URL=http://127.0.0.1:3001
# Secret files and tool grants are managed per project in CoCell.
# Proxy calls use independent private homes; shared debug host mounts are disabled.
# Shared mount configuration used by both deployment scripts (defaults to deploy/local/mounts.json).
# Copy deploy/mounts.example.json and set sharedDirectory.enabled, hostPath, nodeName.
# COCELL_MOUNTS_CONFIG=deploy/local/mounts.json
# Platform OSS slots are populated from OSS_ACCESS_KEY/OSS_SECRET_KEY.
# When sharing an existing Meegle OAuth login with Docker, use the source
# machine's hostname and USER (the CLI binds its refresh store to both).
# MEEGLE_AUTH_HOSTNAME=your-hostname
# MEEGLE_AUTH_USER=your-user
# MEEGLE_HOME=/home/your-user/.meegle
# Do not set MEEGLE_USER_ACCESS_TOKEN when using OAuth automatic refresh.
# Optional SDK config object / raw TOML overrides, applied on top of local config.
# CODEX_CONFIG_JSON={"features":{"multi_agent":true}}
# CODEX_CONFIG_OVERRIDES_JSON=[]
# OPENAI_BASE_URL registers a custom codex_web_proxy provider using HTTP streaming.
# The Sandbox diagnostics/retry proxy requires HTTP streaming (not WebSocket).
# Existing deployments default to new-api (application-managed channel-pinned retries).
# For CLIProxyAPI, the proxy owns upstream retries; CODEX_API_KEY is its client key.
# CODEX_PROXY_KIND=cliproxyapi
# OPENAI_BASE_URL=http://host.docker.internal:8317/v1
# Setup: pnpm cliproxyapi init, pnpm cliproxyapi use-local, pnpm cliproxyapi check
# use-local mirrors only the current access token; host Codex remains the refresh owner.
# Or use up + login for independent OAuth. See scripts/cliproxyapi/manage.mjs.
# Optional explicit kubeconfig to distribute to Sandboxes. It is never read
# unless this absolute path is set; use a least-privileged service account.
# COCELL_KUBECONFIG=/absolute/path/to/kubeconfig
# SANDBOX_ARCHIVED_RECLAIM_AFTER_MS=86400000
# SANDBOX_LIFECYCLE_SCAN_INTERVAL_MS=60000


# Required MySQL project/session metadata storage. CoCell fails startup if MYSQL_URL
# is missing or invalid, or the database is unavailable. There is no file fallback.
# Docker Compose publishes MySQL only to localhost; use strong passwords.
# MYSQL_DATABASE=swarm_hive
# MYSQL_USER=swarm_hive
# MYSQL_PASSWORD=replace-with-a-strong-password
# MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
# MYSQL_LISTEN=127.0.0.1
# MYSQL_PORT=3307
MYSQL_URL=mysql://cocell:replace-with-a-strong-password@127.0.0.1:3307/cocell
