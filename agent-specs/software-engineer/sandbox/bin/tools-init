#!/bin/sh
set -eu

: "${HOME:?HOME is required}"

spec_sandbox="${AGENT_SPEC_SANDBOX_DIR:-/opt/swarm-hive/spec-sandbox}"
manifest="$spec_sandbox/tools.json"
local_root="$HOME/.local"
bin_dir="$local_root/bin"
opt_dir="$local_root/opt"
cache_dir="$HOME/.cache/swarm-hive-tools"
lock_dir="$local_root/state/tools-init.lock"

[ -f "$manifest" ] || { echo "Tool manifest is missing: $manifest" >&2; exit 1; }
mkdir -p "$bin_dir" "$opt_dir" "$cache_dir" "$local_root/state"

attempt=0
until mkdir "$lock_dir" 2>/dev/null; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 120 ]; then
    echo "Timed out waiting for the Spec toolchain lock" >&2
    exit 1
  fi
  sleep 1
done
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT

architecture="$(uname -m)"
case "$architecture" in
  x86_64) node_arch=x64; release_arch=amd64 ;;
  aarch64|arm64) node_arch=arm64; release_arch=arm64 ;;
  *) echo "Unsupported toolchain architecture: $architecture" >&2; exit 1 ;;
esac

node_version="$(jq -er '.node' "$manifest")"
glab_version="$(jq -er '.glab' "$manifest")"
kubectl_version="$(jq -er '.kubectl' "$manifest")"
meegle_version="$(jq -er '.meegle' "$manifest")"
lark_cli_version="$(jq -er '.larkCli' "$manifest")"

download() {
  url="$1"
  destination="$2"
  curl --fail --location --silent --show-error \
    --retry 3 --retry-all-errors --connect-timeout 20 \
    "$url" -o "$destination"
}

node_target="$opt_dir/node-$node_version-linux-$node_arch"
if [ ! -x "$node_target/bin/node" ]; then
  node_archive="$cache_dir/node-v$node_version-linux-$node_arch.tar.xz"
  node_checksums="$cache_dir/node-v$node_version-SHASUMS256.txt"
  download \
    "https://nodejs.org/dist/v$node_version/node-v$node_version-linux-$node_arch.tar.xz" \
    "$node_archive"
  download \
    "https://nodejs.org/dist/v$node_version/SHASUMS256.txt" \
    "$node_checksums"
  expected="$(awk -v file="node-v$node_version-linux-$node_arch.tar.xz" '$2 == file { print $1; exit }' "$node_checksums")"
  [ -n "$expected" ] || { echo "Node.js checksum was not found" >&2; exit 1; }
  printf '%s  %s\n' "$expected" "$node_archive" | sha256sum --check >/dev/null
  node_tmp="$(mktemp -d "$opt_dir/.node-$node_version.XXXXXX")"
  tar -xJf "$node_archive" --strip-components=1 -C "$node_tmp"
  mv "$node_tmp" "$node_target"
fi
for executable in node npm npx corepack; do
  ln -sfn "$node_target/bin/$executable" "$bin_dir/$executable"
done

glab_target="$opt_dir/glab-$glab_version-linux-$release_arch"
if [ ! -x "$glab_target/bin/glab" ]; then
  glab_archive="$cache_dir/glab_${glab_version}_linux_${release_arch}.tar.gz"
  download \
    "https://gitlab.com/gitlab-org/cli/-/releases/v$glab_version/downloads/glab_${glab_version}_linux_${release_arch}.tar.gz" \
    "$glab_archive"
  glab_tmp="$(mktemp -d "$opt_dir/.glab-$glab_version.XXXXXX")"
  tar -xzf "$glab_archive" -C "$glab_tmp"
  mkdir -p "$glab_target/bin"
  install -m 0755 "$glab_tmp/bin/glab" "$glab_target/bin/glab"
  rm -r "$glab_tmp"
fi
ln -sfn "$glab_target/bin/glab" "$bin_dir/glab"

kubectl_target="$opt_dir/kubectl-$kubectl_version-linux-$release_arch"
if [ ! -x "$kubectl_target/kubectl" ]; then
  mkdir -p "$kubectl_target"
  download \
    "https://dl.k8s.io/release/$kubectl_version/bin/linux/$release_arch/kubectl" \
    "$kubectl_target/kubectl"
  download \
    "https://dl.k8s.io/release/$kubectl_version/bin/linux/$release_arch/kubectl.sha256" \
    "$kubectl_target/kubectl.sha256"
  printf '%s  %s\n' "$(cat "$kubectl_target/kubectl.sha256")" "$kubectl_target/kubectl" \
    | sha256sum --check >/dev/null
  chmod 0755 "$kubectl_target/kubectl"
fi
ln -sfn "$kubectl_target/kubectl" "$bin_dir/kubectl"

export PATH="$bin_dir:$PATH"
export npm_config_prefix="$local_root"
export npm_config_cache="$HOME/.cache/npm"

if ! meegle --version 2>/dev/null | grep -qx "$meegle_version"; then
  npm install --global "@lark-project/meegle@$meegle_version"
fi
if ! lark-cli --version 2>/dev/null | grep -q "version $lark_cli_version"; then
  npm install --global "@larksuite/cli@$lark_cli_version"
fi

node --version
glab --version | head -1
kubectl version --client=true
meegle --version
lark-cli --version
