#!/usr/local/bin/node
import { spawnSync } from 'node:child_process';

function fail(message) {
  console.error(message);
  process.exit(2);
}

const tool = process.argv[2];
const policy = process.argv[3];
if (!/^[a-z][a-z0-9_-]{0,63}$/.test(tool ?? '') ||
    !/^(?:-|[a-z][a-z0-9_-]{0,63})$/.test(policy ?? '')) {
  fail('Invalid proxy tool configuration');
}
const args = process.argv.slice(4);
if (args.length > 32 ||
    args.some(arg => arg.includes('\0') || Buffer.byteLength(arg) > 8192) ||
    args.reduce((bytes, arg) => bytes + Buffer.byteLength(arg), 0) > 8192) {
  fail('Invalid tool arguments');
}

const env = { ...process.env, PATH: '/usr/local/bin:/usr/bin:/bin' };
if (policy !== '-') {
  const checked = spawnSync(`/opt/cellbox/tools/${policy}`, [tool, ...args], { env, stdio: 'inherit' });
  if (checked.error) fail(`Tool policy unavailable: ${checked.error.message}`);
  if (checked.status !== 0) process.exit(checked.status ?? 1);
}
const result = spawnSync(`/opt/cellbox/debug-bin/${tool}`, args, { env, stdio: 'inherit' });
if (result.error) console.error(`Tool failed: ${result.error.message}`);
process.exit(result.status ?? 1);
