{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/kubernetesName"
          }
        }
      }
    },
    "existingSecret": {
      "$ref": "#/definitions/kubernetesName",
      "description": "Existing Secret in the release namespace with COCELL_ACCESS_TOKEN, and MYSQL_URL."
    },
    "cellbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiUrl",
        "profile"
      ],
      "properties": {
        "apiUrl": {
          "type": "string",
          "pattern": "^https?://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?/?$"
        },
        "clientId": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,79})?$",
          "description": "Optional data namespace, not an authentication credential."
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^(https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?|http://(?:localhost|127\\.0\\.0\\.1)(?::[0-9]{1,5})?)/?$"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolBrokerUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^/@\\s?#]+/?$"
        },
        "ossEndpoint": {
          "type": "string",
          "pattern": "^$|^https?://[^/@\\s?#]+(?:/[^\\s?#]*)?$"
        },
        "codexModel": {
          "type": "string"
        },
        "openaiBaseUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^/@\\s?#]+(?:/[^\\s?#]*)?$"
        },
        "codexProxyKind": {
          "type": "string",
          "enum": [
            "",
            "cliproxyapi",
            "litellm",
            "new-api"
          ]
        },
        "credentialSlots": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "enum": [
            3001
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "previewSubdomains",
        "className",
        "annotations",
        "tlsSecretName",
        "previewTlsSecretName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "previewSubdomains": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tlsSecretName": {
          "type": "string"
        },
        "previewTlsSecretName": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingClaim",
        "size",
        "storageClassName",
        "accessModes"
      ],
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"
        },
        "storageClassName": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce"
            ]
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceQuantities"
        },
        "limits": {
          "$ref": "#/definitions/resourceQuantities"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "sharedDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "hostPath",
        "nodeName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostPath": {
          "type": "string",
          "pattern": "^$|^/[^\\s]+$"
        },
        "nodeName": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "hostPath": {
            "minLength": 2
          },
          "nodeName": {
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "kubernetesName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": "string"
        }
      }
    }
  }
}
