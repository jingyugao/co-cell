+++ b/packages/shared/pkg/featureflags/local_sync_wp_test.go
@@ -0,0 +1,19 @@
+package featureflags
+
+import (
+	"os"
+	"testing"
+)
+
+// Run in fresh processes with E2B_USE_SYNC_WP=true and false: flags are
+// registered during package initialization, before the test starts.
+func TestLocalSyncWP(t *testing.T) {
+	client, err := NewClient()
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := os.Getenv("E2B_USE_SYNC_WP") == "true"
+	if got := client.BoolFlag(t.Context(), UseSyncWPFlag); got != want {
+		t.Fatalf("synchronous write protection = %v, want %v", got, want)
+	}
+}
