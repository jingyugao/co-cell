# Copy to deploy.env (ignored by Git). Shell environment overrides these values.
# Use absolute paths: dotenv does not expand ~, $HOME or ${VARIABLE}.
COCELL_KUBE_CONTEXT=YOUR_TEST_CONTEXT
COCELL_NAMESPACE=co-cell
COCELL_HELM_RELEASE=co-cell
COCELL_REGISTRY_ENDPOINT=http://REGISTRY_HOST:PORT
# Enable after bootstrapping the coordinated single replica once.
# COCELL_MULTI_API=1
# COCELL_API_REPLICAS=2
CELLBOX_SOURCE_DIR=/ABSOLUTE/PATH/TO/cell-box

# Optional proxy bypass for the registry/node addresses.
# NO_PROXY=127.0.0.1,localhost,REGISTRY_HOST,NODE_HOST
# no_proxy=127.0.0.1,localhost,REGISTRY_HOST,NODE_HOST

# Live tests read the existing operator Secret and open a loopback port-forward.
# No credential values need to be stored here. This context must be explicit.
COCELL_E2E_KUBE_CONTEXT=YOUR_TEST_CONTEXT
COCELL_E2E_NAMESPACE=co-cell
COCELL_E2E_HELM_RELEASE=co-cell
COCELL_E2E_SERVICE=co-cell

# Or connect directly, without Kubernetes:
# COCELL_E2E_BASE_URL=https://YOUR_COCELL_ORIGIN
# COCELL_E2E_ACCESS_TOKEN=SUPPLY_THROUGH_ENVIRONMENT
# COCELL_E2E_PUBLIC_URL=https://PUBLIC_ORIGIN_IF_DIFFERENT
# COCELL_E2E_MODEL=gpt-6-luna
