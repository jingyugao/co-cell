{
  "name": "co-cell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "tsx backend/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx backend/index.ts",
    "typecheck": "tsc --noEmit",
    "capture:http": "tsx backend/infra/diagnostics/capture-demo.ts",
    "credentials:import": "tsx backend/connections/import-local.ts",
    "credentials:migrate": "tsx backend/connections/migrate-credentials.ts",
    "cliproxyapi": "node scripts/cliproxyapi/manage.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@openai/codex": "0.153.4",
    "@co-cell/agentcore": "file:packages/agentcore",
    "@co-cell/docker-sandbox": "file:packages/docker-sandbox",
    "@co-cell/sandbox": "file:packages/sandbox",
    "hono": "4.13.3",
    "js-tiktoken": "1.0.21",
    "mysql2": "3.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
