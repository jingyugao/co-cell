#!/bin/sh
set -eu

: "${HOME:?HOME is required}"
: "${MEEGLE_HOST:?MEEGLE_HOST is required}"
: "${MEEGLE_USER_ACCESS_TOKEN:?MEEGLE_USER_ACCESS_TOKEN is required}"

for required in \
  "$HOME/.lark-cli" \
  "$HOME/.local/share/lark-cli"
do
  if [ ! -d "$required" ]; then
    echo "Missing mounted Feishu CLI credential directory: $required" >&2
    exit 1
  fi
done

meegle_status="$(meegle auth status --format json)"
printf '%s' "$meegle_status" | jq -e '.authenticated == true' >/dev/null \
  || { echo "Meegle user credential is not authenticated" >&2; exit 1; }

lark_status="$(lark-cli auth status --json)"
printf '%s' "$lark_status" | jq -e \
  '.identities.user.available == true
   and (.identities.user.status == "ready" or .identities.user.status == "needs_refresh")' \
  >/dev/null \
  || { echo "Lark CLI user credential is not ready" >&2; exit 1; }

echo "feishu-cli=user authenticated"
