[Unit]
Description=E2B privileged sandbox orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/example/Code/swarm-hive/data/e2b
EnvironmentFile=/home/example/Code/swarm-hive/data/e2b/config/orchestrator.env
ExecStartPre=/bin/bash /home/example/Code/swarm-hive/scripts/e2b-host-preflight.sh
ExecStartPre=/bin/bash /home/example/Code/swarm-hive/scripts/e2b-wait-dependencies.sh orchestrator
ExecStart=/usr/bin/env DISABLE_STARTUP_RECLAIM=true FORCE_STOP=false /home/example/Code/swarm-hive/data/e2b/bin/orchestrator
Restart=no
TimeoutStartSec=infinity
TimeoutStopSec=infinity
KillMode=mixed
Delegate=yes
UMask=0077

[Install]
WantedBy=multi-user.target
